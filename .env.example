# Local server config. Never commit real values; production secrets belong in EdgeOne server env.
LOOM_ORIGIN=http://localhost:5173
LOOM_PUBLIC_BASE_URL=http://localhost:5173
LOOM_COOKIE_SECRET=
LOOM_COOKIE_KEY_ID=k1
LOOM_COOKIE_PREVIOUS_SECRETS_JSON={}
LOOM_COOKIE_TTL_SECONDS=2592000
LOOM_BLOB_STORE=loom-space-private

# Disabled by default. Configure only after independently verifying a supplier-side hard spend cap,
# alerting, and circuit breaker; this flag records that operator confirmation, not a metered quota.
LOOM_AGENT_ENABLED=false
LOOM_AGENT_PROVIDER_BUDGET_CONFIRMED=false
LOOM_PROVIDER_BASE_URL=https://api.example.com/v1
LOOM_PROVIDER_API_KEY=
LOOM_PROVIDER_MODEL=
LOOM_PROVIDER_STRUCTURED_MODE=json_object
LOOM_PROVIDER_TIMEOUT_MS=30000
LOOM_PROVIDER_MAX_INPUT_BYTES=131072
LOOM_MAX_JSON_BYTES=393216
LOOM_MAX_PROMPT_BYTES=8192

# Best-effort per-process soft abuse limits; they reset on restart and are not shared across EdgeOne instances.
LOOM_SOFT_WRITE_LIMIT_PER_MINUTE=60
LOOM_SOFT_MAX_SPACES_PER_VISITOR=100
LOOM_SOFT_MAX_REVISIONS_PER_VISITOR=500

# Production deployment gate: set true only after equivalent EdgeOne edge rate limits are configured.
LOOM_EDGE_RATE_LIMIT_CONFIRMED=false
